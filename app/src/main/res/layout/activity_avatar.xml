<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выбор аватара"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCoinsAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪙 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Бесплатные"
            android:textSize="16sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="8dp" />

        <GridLayout
            android:id="@+id/gridFree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Редкие (1000 🪙)"
            android:textSize="16sp"
            android:textColor="#AAAAAA"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <GridLayout
            android:id="@+id/gridPremium1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Легендарные (2500 🪙)"
            android:textSize="16sp"
            android:textColor="#FF5722"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <GridLayout
            android:id="@+id/gridPremium2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5" />

    </LinearLayout>
</ScrollView>
